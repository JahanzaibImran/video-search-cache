# Which backend serves video data: youtube (official YouTube Data API, YouTube only)
# or scrapecreators (YouTube + TikTok, comments and transcripts).
VIDEO_PROVIDER=youtube

# YouTube Data API v3 key (VIDEO_PROVIDER=youtube): https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# ScrapeCreators key (VIDEO_PROVIDER=scrapecreators): https://app.scrapecreators.com
SCRAPECREATORS_API_KEY=

# Credits each user starts with. Prices per action live in src/lib/credits/costs.ts.
CREDIT_LIMIT=20
